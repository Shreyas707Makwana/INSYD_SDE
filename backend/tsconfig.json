{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "exclude": ["node_modules", "src/tests"]
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
